# Copy this file to ".env" and fill in the values. Never commit the real .env.

# From @BotFather (Telegram) — the bot's API token.
TELEGRAM_BOT_TOKEN=

# The Telegram numeric user id of the bot owner (your dad, or you during setup).
# Only this user can run admin/helper commands. Find it by messaging the bot
# /whoami once the bot is running.
OWNER_USER_ID=

# Comma-separated list of allowed group chat ids (e.g. -1001234567890,-1009876543210).
# The bot ignores every message from any chat NOT in this list.
# Leave EMPTY during first setup so the bot can report chat ids of groups it's added to,
# then fill this in and restart.
ALLOWED_CHAT_IDS=

# Optional: Anthropic API key for the LLM classifier (sick notes in any language).
# If unset, the bot still runs — it just uses rule-based +/- detection only and
# marks free-text messages as "other" for manual review.
ANTHROPIC_API_KEY=

# Model for classification. Haiku is cheap and fast — right for high-volume,
# short, multilingual intent classification.
CLASSIFIER_MODEL=claude-haiku-4-5

# Startup default for mirroring the bot's log lines to the OWNER's Telegram DM.
# off by default; toggle at runtime by DMing the bot /debug on  or  /debug off.
DEBUG_DM=off

# Partially-AI mode: use the light model to classify messages the rules can't
# resolve. Needs ANTHROPIC_API_KEY. off by default; toggle at runtime with /ai on|off.
AI_ASSIST=off
