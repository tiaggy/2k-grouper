# Copy this file to ".env" and fill in the values. Never commit the real .env.
# NOTE: owners, ignored users, and tracked groups are NOT here — they live in the
# Notion "Bot Config" / "Tracked Groups" databases (the source of truth). .env is
# only secrets + toggles that Notion can't hold, or that are needed before Notion
# is reachable.

# From @BotFather (Telegram) — the bot's API token.
TELEGRAM_BOT_TOKEN=

# Emergency anti-lockout owner id (Telegram numeric user id). Owners are normally
# managed in the Notion Bot Config; this is only used as a fallback if Notion is
# unreachable at startup.
OWNER_USER_ID=

# --- AI classifier backend (OpenAI-compatible; used only when AI_ASSIST is on) ---
# OPENAI_BASE_URL: leave empty for api.openai.com, or point at a custom / proxy /
# self-hosted OpenAI-compatible endpoint.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
# Tried on the SAME endpoint if the primary model errors / is rate-limited /
# unavailable. Pick something cheap and reliable as a safety net.
OPENAI_FALLBACK_MODEL=gpt-4o-mini

# Partially-AI mode: the model classifies messages the +/- rules can't resolve.
# Needs OPENAI_API_KEY. Toggle live from the owner /dashboard (AI-assist button).
AI_ASSIST=off

# Startup default for mirroring the bot's log lines to owners' DMs. Toggle live
# from the owner /dashboard (Debug button).
DEBUG_DM=off

# --- Notion ---------------------------------------------------------------
NOTION_TOKEN=
# Capture Log: the new data-source model needs BOTH the database id and its data
# source id (Notion API → GET the database, read `data_sources[0].id`).
NOTION_DB_ID=
NOTION_DB_DS_ID=
NOTION_VERSION=2022-06-28
NOTION_DS_VERSION=2025-09-03
# Bot Config (Owner / Ignored User rows) + Tracked Groups (one row per group,
# with a Client relation) + Telegram Accounts (one row per Telegram user, with a
# Person relation to your Applicant Tracker).
NOTION_CONFIG_DB_ID=
NOTION_TRACKED_DB_ID=
NOTION_ACCOUNTS_DB_ID=
# Week Approvals (Label / Group relation / Week Start date / Approved checkbox)
# — used by the web dashboard (dashboard/) to freeze a team's week once approved.
NOTION_APPROVALS_DB_ID=
CONFIG_REFRESH_SECONDS=300

# --- Resilience: pausing on an outage instead of dropping/misclassifying ---
# If Notion (or, in AI mode, the AI backend) is unavailable, the bot pauses
# processing and re-checks health this often. Notion outages alert owners
# immediately; an AI outage only alerts after AI_ALERT_AFTER_SECONDS (a brief
# blip stays quiet — the bot keeps working via OPENAI_FALLBACK_MODEL if that
# alone is what's failing).
PAUSE_RETRY_SECONDS=20
HEALTH_TTL_SECONDS=20
AI_ALERT_AFTER_SECONDS=3600

# --- Daily "missing" sweep ---------------------------------------------------
# Once per weekday, write a `missing` Capture Log row for each expected worker
# with no record yet that day. MISSING_SWEEP_HOUR=0 runs it at the START of the
# day (everyone starts `missing`, then each row is replaced by the real record
# as the worker reports); a later hour (e.g. 20) instead marks only end-of-day
# no-shows. Standalone: `py missing.py [date [end-date]]`.
MISSING_SWEEP=on
MISSING_SWEEP_HOUR=0
# A worker is "expected" if they appeared in the Capture Log within this many
# days before the swept date.
MISSING_ROSTER_LOOKBACK_DAYS=30
# Only mark people whose Person (Applicant Tracker) is hired. Leave off until
# the Applicant Tracker is shared with this integration.
MISSING_REQUIRE_HIRED=off
MISSING_HIRED_PROP=Stage
MISSING_HIRED_VALUES=Hired

# --- Runtime -----------------------------------------------------------------
# Where state files (progress/spool/caches/events log) live. Leave unset for a
# plain `py bot.py` run (defaults to this directory); Docker sets STATE_DIR=/data
# on a mounted volume — see docker-compose.yml.
STATE_DIR=
# Under a process supervisor (Docker `restart:`, systemd, NSSM) the owner
# Restart button should just exit and let the supervisor relaunch it. Leave off
# for a plain `py bot.py` run, where the bot self-respawns instead.
EXIT_ON_RESTART=off

# --- Web dashboard (separate container — see README.docker.md) --------------
# How often (seconds) the background loop re-derives NOT-approved weeks from
# the Capture Log. Approved weeks are frozen and skipped entirely.
DASHBOARD_REFRESH_SECONDS=60
# Shared secret required to approve/un-approve a week. Set a real value before
# exposing the dashboard beyond localhost; leave unset to disable approving
# entirely (a pure view-only dashboard).
DASHBOARD_APPROVE_TOKEN=
